#!/usr/bin/env bash
set -euo pipefail

BASE="/sys/class/power_supply"
BAT="$BASE/BAT0"
AC="$BASE/ADP1"

read_int() { cat "$1" 2>/dev/null | tr -d '\n' || true; }

if [[ ! -d "$BAT" ]]; then
  echo "Battery not found at $BAT"
  exit 1
fi

ac_online="$(read_int "$AC/online")"
status="$(read_int "$BAT/status")"
capacity="$(read_int "$BAT/capacity")"

charge_now="$(read_int "$BAT/charge_now")"
charge_full="$(read_int "$BAT/charge_full")"
current_now="$(read_int "$BAT/current_now")"   # usually in µA (microamps)

echo "AC: $([[ "$ac_online" == "1" ]] && echo Connected || echo Disconnected)"
echo "Battery: BAT0"
echo "  capacity: ${capacity}%"
echo "  status:   ${status}"

# Guard if some values missing
if [[ -z "${charge_now}" || -z "${charge_full}" || -z "${current_now}" ]]; then
  echo "  (Missing charge/current data; can't estimate time.)"
  exit 0
fi

# Convert microamps to amps (float) using awk (portable)
# Some systems report current as negative when discharging.
# We'll interpret sign:
#   current_now > 0 => charging
#   current_now < 0 => discharging
#   near 0          => idle
abs_uA="$(awk -v x="$current_now" 'BEGIN{ if (x<0) x=-x; print x }')"

# Threshold: treat very small currents as idle/no meaningful charge
IDLE_UA=50000   # 50 mA (in µA). adjust if needed.

inferred="Unknown"
if [[ "$ac_online" == "1" ]]; then
  if awk -v x="$current_now" -v t="$IDLE_UA" 'BEGIN{ exit !(x>t) }'; then
    inferred="Charging"
  else
    inferred="Idle (Plugged)"
  fi
else
  inferred="Discharging"
fi
echo "  inferred: $inferred"

# Time estimates (hours) based on charge units:
# charge_now and charge_full are typically in µAh. current_now in µA.
# time_hours = delta_charge_uAh / current_uA
# We'll use absolute current magnitude for the division.
if awk -v x="$abs_uA" 'BEGIN{ exit !(x>0) }'; then
  if [[ "$inferred" == "Charging" ]]; then
    delta="$(awk -v full="$charge_full" -v now="$charge_now" 'BEGIN{ d=full-now; if(d<0) d=0; print d }')"
    hours="$(awk -v d="$delta" -v i="$abs_uA" 'BEGIN{ print d/i }')"
    # format hours -> h:mm
    hm="$(awk -v h="$hours" 'BEGIN{
      total=int(h*60+0.5);
      hh=int(total/60); mm=total%60;
      printf "%d:%02d", hh, mm
    }')"
    echo "  time to full: $hm (h:mm)"
  elif [[ "$inferred" == "Discharging" ]]; then
    hours="$(awk -v now="$charge_now" -v i="$abs_uA" 'BEGIN{ print now/i }')"
    hm="$(awk -v h="$hours" 'BEGIN{
      total=int(h*60+0.5);
      hh=int(total/60); mm=total%60;
      printf "%d:%02d", hh, mm
    }')"
    echo "  time remaining: $hm (h:mm)"
  fi
fi

# Extra useful info
cycle_count="$(read_int "$BAT/cycle_count")"
temp="$(read_int "$BAT/temp")"  # often in tenths of °C
voltage_now="$(read_int "$BAT/voltage_now")"

[[ -n "$cycle_count" ]] && echo "  cycles: $cycle_count"

if [[ -n "$temp" ]]; then
  # many drivers expose temp in tenths of °C
  echo "  temp: $(awk -v t="$temp" 'BEGIN{ printf "%.1f°C", t/10 }')"
fi

if [[ -n "$voltage_now" ]]; then
  # typically in µV
  echo "  voltage: $(awk -v v="$voltage_now" 'BEGIN{ printf "%.3f V", v/1000000 }')"
fi
