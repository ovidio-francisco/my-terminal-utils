#!/usr/bin/env bash
#
# cpu_info.sh — shows CPU information at 3 detail levels
#
# Usage:
#   cpu_info.sh [-l LEVEL] [-s|-i|-v] [-h]
#
#   -l, --level N        1=simple (default), 2=intermediate, 3=verbose
#   -s, --simple         shortcut for -l 1
#   -i, --intermediate   shortcut for -l 2
#   -v, --verbose        shortcut for -l 3
#   -h, --help           show this help

set -uo pipefail

LEVEL=1

# ---------------------------------------------------------------------------
# Colors / styles
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
  BOLD=$'\e[1m'
  DIM=$'\e[2m'
  RESET=$'\e[0m'
  CYAN=$'\e[36m'
  GRAY=$'\e[90m'
  RED=$'\e[31m'
else
  BOLD=""
  DIM=""
  RESET=""
  CYAN=""
  GRAY=""
  RED=""
fi

# ---------------------------------------------------------------------------
# Help / argument parsing
# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
${BOLD}cpu_info.sh${RESET} — CPU information

Usage: $(basename "$0") [-l LEVEL] [--simple|--intermediate|--verbose] [-h]

  -l, --level N          Detail level: 1=simple (default), 2=intermediate, 3=verbose
  -s, --simple           Shortcut for -l 1
  -i, --intermediate     Shortcut for -l 2
  -v, --verbose          Shortcut for -l 3
  -h, --help             Show this help

Levels:
  1   Model and CPU/core/thread count
  2   Architecture, topology, clocks and cache
  3   Detailed CPU information and per-CPU topology
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -l|--level)
      LEVEL="${2:-}"
      shift 2
      ;;
    -s|--simple)
      LEVEL=1
      shift
      ;;
    -i|--intermediate)
      LEVEL=2
      shift
      ;;
    -v|--verbose)
      LEVEL=3
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "${RED}Unknown option: $1${RESET}" >&2
      usage
      exit 1
      ;;
  esac
done

if ! [[ "$LEVEL" =~ ^[1-3]$ ]]; then
  echo "${RED}Invalid level: '$LEVEL' (use 1, 2 or 3)${RESET}" >&2
  exit 1
fi

if ! command -v lscpu >/dev/null 2>&1; then
  echo "${RED}lscpu not found.${RESET}" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Read one field from lscpu.
lscpu_value() {
  local wanted="$1"

  LC_ALL=C lscpu | awk -F: -v wanted="$wanted" '
    {
      key=$1
      gsub(/^[ \t]+|[ \t]+$/, "", key)

      if (key == wanted) {
        value=$2
        gsub(/^[ \t]+|[ \t]+$/, "", value)
        print value
        exit
      }
    }
  '
}

show_value() {
  local label="$1"
  local value="$2"

  [[ -n "$value" ]] &&
    printf "  %-20s %s\n" "$label" "$value"
}

format_mhz() {
  local mhz="$1"

  [[ -z "$mhz" ]] && {
    echo "N/A"
    return
  }

  awk -v mhz="$mhz" 'BEGIN {
    if (mhz >= 1000)
      printf "%.2f GHz", mhz / 1000
    else
      printf "%.0f MHz", mhz
  }'
}

current_clock() {
  local total=0
  local count=0
  local value

  # Prefer cpufreq data from sysfs.
  for file in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
    [[ -r "$file" ]] || continue

    read -r value < "$file"

    [[ "$value" =~ ^[0-9]+$ ]] || continue

    total=$((total + value))
    count=$((count + 1))
  done

  if (( count > 0 )); then
    awk -v total="$total" -v count="$count" \
      'BEGIN { printf "%.0f", (total / count) / 1000 }'
    return
  fi

  # Fallback to /proc/cpuinfo.
  awk -F: '
    /cpu MHz/ {
      sum += $2
      count++
    }

    END {
      if (count > 0)
        printf "%.0f", sum / count
    }
  ' /proc/cpuinfo 2>/dev/null
}

# ---------------------------------------------------------------------------
# Gather CPU information
# ---------------------------------------------------------------------------

model="$(lscpu_value "Model name")"
vendor="$(lscpu_value "Vendor ID")"
architecture="$(lscpu_value "Architecture")"

logical_cpus="$(lscpu_value "CPU(s)")"
online_cpus="$(lscpu_value "On-line CPU(s) list")"

threads_per_core="$(lscpu_value "Thread(s) per core")"
cores_per_socket="$(lscpu_value "Core(s) per socket")"
sockets="$(lscpu_value "Socket(s)")"

min_mhz="$(lscpu_value "CPU min MHz")"
max_mhz="$(lscpu_value "CPU max MHz")"
current_mhz="$(current_clock)"

l1d="$(lscpu_value "L1d cache")"
l1i="$(lscpu_value "L1i cache")"
l2="$(lscpu_value "L2 cache")"
l3="$(lscpu_value "L3 cache")"

byte_order="$(lscpu_value "Byte Order")"
address_sizes="$(lscpu_value "Address sizes")"

virtualization="$(lscpu_value "Virtualization")"
hypervisor="$(lscpu_value "Hypervisor vendor")"

numa_nodes="$(lscpu_value "NUMA node(s)")"

# Calculate total physical cores if topology is available.
physical_cores=""

if [[ "$cores_per_socket" =~ ^[0-9]+$ &&
      "$sockets" =~ ^[0-9]+$ ]]; then
  physical_cores=$((cores_per_socket * sockets))
fi

# ---------------------------------------------------------------------------
# Level 1 — Simple
# ---------------------------------------------------------------------------
print_simple() {
  printf "%-10s %s\n" "CPU:" "${model:-Unknown}"

  [[ -n "$physical_cores" ]] &&
    printf "%-10s %s\n" "Cores:" "$physical_cores"

  [[ -n "$logical_cpus" ]] &&
    printf "%-10s %s\n" "Threads:" "$logical_cpus"

  if [[ -n "$current_mhz" ]]; then
    printf "%-10s %s\n" "Clock:" "$(format_mhz "$current_mhz")"
  fi
}

# ---------------------------------------------------------------------------
# Level 2 — Intermediate
# ---------------------------------------------------------------------------
print_intermediate() {
  echo "${BOLD}CPU${RESET}"

  show_value "Model:" "$model"
  show_value "Vendor:" "$vendor"
  show_value "Architecture:" "$architecture"

  echo

  echo "${BOLD}Topology${RESET}"

  show_value "Sockets:" "$sockets"
  show_value "Cores:" "$physical_cores"
  show_value "Cores/socket:" "$cores_per_socket"
  show_value "Threads/core:" "$threads_per_core"
  show_value "Logical CPUs:" "$logical_cpus"

  echo

  echo "${BOLD}Clock${RESET}"

  [[ -n "$current_mhz" ]] &&
    show_value "Current (average):" "$(format_mhz "$current_mhz")"

  [[ -n "$min_mhz" ]] &&
    show_value "Minimum:" "$(format_mhz "$min_mhz")"

  [[ -n "$max_mhz" ]] &&
    show_value "Maximum:" "$(format_mhz "$max_mhz")"

  echo

  echo "${BOLD}Cache${RESET}"

  show_value "L1 data:" "$l1d"
  show_value "L1 instruction:" "$l1i"
  show_value "L2:" "$l2"
  show_value "L3:" "$l3"

  echo
}

# ---------------------------------------------------------------------------
# Level 3 — Verbose
# ---------------------------------------------------------------------------
print_verbose() {
  echo "${CYAN}────────────────────────────────────────${RESET}"
  echo "${BOLD}CPU${RESET}"
  echo "${CYAN}────────────────────────────────────────${RESET}"

  show_value "Model:" "$model"
  show_value "Vendor:" "$vendor"
  show_value "Architecture:" "$architecture"
  show_value "Byte order:" "$byte_order"
  show_value "Address sizes:" "$address_sizes"

  echo

  echo "${CYAN}────────────────────────────────────────${RESET}"
  echo "${BOLD}Topology${RESET}"
  echo "${CYAN}────────────────────────────────────────${RESET}"

  show_value "Sockets:" "$sockets"
  show_value "Cores:" "$physical_cores"
  show_value "Cores/socket:" "$cores_per_socket"
  show_value "Threads/core:" "$threads_per_core"
  show_value "Logical CPUs:" "$logical_cpus"
  show_value "Online CPUs:" "$online_cpus"
  show_value "NUMA nodes:" "$numa_nodes"

  echo

  echo "${CYAN}────────────────────────────────────────${RESET}"
  echo "${BOLD}Clock${RESET}"
  echo "${CYAN}────────────────────────────────────────${RESET}"

  [[ -n "$current_mhz" ]] &&
    show_value "Current (average):" "$(format_mhz "$current_mhz")"

  [[ -n "$min_mhz" ]] &&
    show_value "Minimum:" "$(format_mhz "$min_mhz")"

  [[ -n "$max_mhz" ]] &&
    show_value "Maximum:" "$(format_mhz "$max_mhz")"

  echo

  echo "${CYAN}────────────────────────────────────────${RESET}"
  echo "${BOLD}Cache${RESET}"
  echo "${CYAN}────────────────────────────────────────${RESET}"

  show_value "L1 data:" "$l1d"
  show_value "L1 instruction:" "$l1i"
  show_value "L2:" "$l2"
  show_value "L3:" "$l3"

  if [[ -n "$virtualization" || -n "$hypervisor" ]]; then
    echo

    echo "${CYAN}────────────────────────────────────────${RESET}"
    echo "${BOLD}Virtualization${RESET}"
    echo "${CYAN}────────────────────────────────────────${RESET}"

    show_value "Technology:" "$virtualization"
    show_value "Hypervisor:" "$hypervisor"
  fi

  echo

  echo "${CYAN}────────────────────────────────────────${RESET}"
  echo "${BOLD}Logical CPUs${RESET}"
  echo "${CYAN}────────────────────────────────────────${RESET}"

  if ! LC_ALL=C lscpu \
      -e=CPU,CORE,SOCKET,NODE,ONLINE,MHZ,MINMHZ,MAXMHZ 2>/dev/null; then
    LC_ALL=C lscpu -e
  fi

  echo

  if [[ -r /proc/cpuinfo ]]; then
    flags="$(
      awk -F: '
        /^flags[ \t]*:/ {
          sub(/^[ \t]+/, "", $2)
          print $2
          exit
        }

        /^Features[ \t]*:/ {
          sub(/^[ \t]+/, "", $2)
          print $2
          exit
        }
      ' /proc/cpuinfo
    )"

    if [[ -n "$flags" ]]; then
      echo "${CYAN}────────────────────────────────────────${RESET}"
      echo "${BOLD}CPU Features${RESET}"
      echo "${CYAN}────────────────────────────────────────${RESET}"
      fold -s -w 78 <<< "$flags" | sed 's/^/  /'
      echo
    fi
  fi
}

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
case "$LEVEL" in
  1) print_simple ;;
  2) print_intermediate ;;
  3) print_verbose ;;
esac
