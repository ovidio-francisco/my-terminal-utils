#!/usr/bin/env bash

# ┌──────────────────────────────────────────────────────────────┐
# │ Created by: ChatGPT                                          │
# │ Conceived and guided by: Ovídio José Francisco               │
# └──────────────────────────────────────────────────────────────┘

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  show-md FILE [--dark] [--width <value>]

Examples:
  show-md README.md
  show-md README.md --dark
  show-md --dark --width 90em README.md
  show-md README.md --width 1100px

Notes:
  --width accepts any valid CSS length (e.g., 72em, 900px, 80ch, 100%).
EOF
  exit 1
}

dark_mode=false
width="40em"
in=""

# Parse args (order-independent)
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dark)
      dark_mode=true
      shift
      ;;
    --width)
      shift
      [[ $# -gt 0 ]] || { echo "Missing value for --width" >&2; usage; }
      width="$1"
      shift
      ;;
    -h|--help)
      usage
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage
      ;;
    *)
      [[ -z "$in" ]] && in="$1" || { echo "Too many positional args" >&2; usage; }
      shift
      ;;
  esac
done

[[ -n "$in" ]] || usage
[[ -f "$in" ]] || { echo "File not found: $in" >&2; exit 1; }

base="$(basename "${in%.*}")"
out="/tmp/${base}.html"

# ---------------------------------------------------------------
# Build header snippet with embedded CSS (so it won't disappear)
# ---------------------------------------------------------------
header_file="$(mktemp --suffix=.html)"

# Base layout CSS (always applied): override Pandoc template width,
# but set it to user-specified value.
cat > "$header_file" <<EOF
<style>
:root {
  --content-width: ${width};
}

/* Set your preferred reading width */
body {
  max-width: var(--content-width);
  margin: 0 auto;
  padding: 1rem;
}

/* Nice defaults */
pre { overflow-x: auto; }
</style>
EOF

# Dark theme CSS (optional)
if $dark_mode; then
  cat >> "$header_file" <<'EOF'
<style>
html, body {
  background-color: #1e1e1e;
  color: #dddddd;
  font-family: sans-serif;
}

a { color: #8ab4f8; }

pre, code {
  background-color: #252526;
  color: #d4d4d4;
  padding: 0.4em;
  border-radius: 4px;
}

h1, h2, h3, h4, h5, h6 { color: #ffffff; }
</style>
EOF
fi

cleanup() {
  rm -f "$header_file"
}
trap cleanup EXIT

# ---------------------------------------------------------------
# Pandoc conversion
# ---------------------------------------------------------------
pandoc "$in" \
  -f gfm \
  -s \
  -o "$out" \
  --metadata title="" \
  --include-in-header="$header_file" \
  --quiet

# ---------------------------------------------------------------
# Open result
# ---------------------------------------------------------------
if command -v xdg-open >/dev/null; then
  xdg-open "$out" >/dev/null 2>&1 &
else
  echo "HTML saved to: $out"
fi
