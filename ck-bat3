#!/usr/bin/env bash
set -euo pipefail

BASE="/sys/class/power_supply"

# Find AC adapter (ADP*, AC*, ACAD*)
ac_dev=""
for d in "$BASE"/ADP* "$BASE"/AC* "$BASE"/ACAD*; do
  [[ -e "$d" ]] || continue
  ac_dev="$d"
  break
done

ac_online="unknown"
if [[ -n "${ac_dev}" && -f "$ac_dev/online" ]]; then
  ac_online=$(cat "$ac_dev/online" 2>/dev/null || echo "unknown")
fi

# Find batteries
shopt -s nullglob
bats=("$BASE"/BAT*)
if (( ${#bats[@]} == 0 )); then
  echo "No batteries found."
  exit 0
fi

if [[ "$ac_online" == "1" ]]; then
  echo "AC: Connected"
elif [[ "$ac_online" == "0" ]]; then
  echo "AC: Disconnected"
else
  echo "AC: Unknown"
fi
echo

for bat in "${bats[@]}"; do
  name=$(basename "$bat")
  capacity=$(cat "$bat/capacity" 2>/dev/null || echo "?")
  status=$(cat "$bat/status" 2>/dev/null || echo "Unknown")

  # These may or may not exist depending on driver
  power_now=""
  current_now=""
  energy_now=""
  charge_now=""

  [[ -f "$bat/power_now"   ]] && power_now=$(cat "$bat/power_now"   2>/dev/null || true)
  [[ -f "$bat/current_now" ]] && current_now=$(cat "$bat/current_now" 2>/dev/null || true)
  [[ -f "$bat/energy_now"  ]] && energy_now=$(cat "$bat/energy_now"  2>/dev/null || true)
  [[ -f "$bat/charge_now"  ]] && charge_now=$(cat "$bat/charge_now"  2>/dev/null || true)

  # Infer a more reliable state
  # If on AC and not charging (no current/power), call it "Idle (Plugged)"
  inferred="$status"
  if [[ "$ac_online" == "1" ]]; then
    if [[ "$status" == "Charging" ]]; then
      inferred="Charging"
    else
      # If we can detect near-zero draw, treat as idle
      if [[ -n "$power_now" && "$power_now" =~ ^[0-9]+$ && "$power_now" -lt 500000 ]]; then
        inferred="Idle (Plugged)"
      elif [[ -n "$current_now" && "$current_now" =~ ^[0-9]+$ && "$current_now" -lt 50000 ]]; then
        inferred="Idle (Plugged)"
      else
        # Some firmwares say "Full" even at <100 when not charging
        inferred="Idle (Plugged)"
      fi
    fi
  elif [[ "$ac_online" == "0" ]]; then
    inferred="Discharging"
  fi

  echo "Battery: $name"
  echo "  Charge:   ${capacity}%"
  echo "  Status:   $status"
  echo "  Inferred: $inferred"

  [[ -n "$energy_now"  ]] && echo "  energy_now:  $energy_now"
  [[ -n "$charge_now"  ]] && echo "  charge_now:  $charge_now"
  [[ -n "$power_now"   ]] && echo "  power_now:   $power_now"
  [[ -n "$current_now" ]] && echo "  current_now: $current_now"
  echo
done
