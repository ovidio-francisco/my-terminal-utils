#!/usr/bin/env bash
set -euo pipefail

# ============================================================
# Config
# ============================================================
repos_file="${REPOS_FILE:-$HOME/.repos}"

# Column widths (override via env)
# e.g.: COL_NAME=28 COL_BRANCH=16 repos
COL_ICON="${COL_ICON:-4}"
COL_NAME="${COL_NAME:-22}"
COL_BRANCH="${COL_BRANCH:-12}"
COL_CHANGES="${COL_CHANGES:-13}"
COL_SYNC="${COL_SYNC:-18}"

SCAN_DEPTH="${SCAN_DEPTH:-4}"

# ============================================================
# Colors & icons
# ============================================================
RESET=$'\033[0m'
BOLD=$'\033[1m'
RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
GRAY=$'\033[90m'

ICON_ERROR='✗'
ICON_WARNING='▲'
ICON_REPO='📁'

# Terminal display width (columns), not character count.
# Emoji-presentation glyphs (📁) tend to render 2 columns wide; symbol
# glyphs (✗ ▲) tend to render 1 (and look tighter, so they get an extra
# trailing space in pad_icon below). Add entries here if you add icons.
declare -A ICON_WIDTH=(
  ["$ICON_REPO"]=2
  ["$ICON_ERROR"]=1
  ["$ICON_WARNING"]=1
)
ICON_WIDTH_DEFAULT=1

# ============================================================
# Flags (runtime)
# ============================================================
verbose=0
list_files=0        # -l : show "files" section even when clean (verbose output)
files_dirty_only=0  # -f : show "files" section only when dirty (verbose output) overrides -l
dirty_only=0        # -d : list only dirty repos (short + verbose)
show_path=0          # -p/--path : show repo path (default off)
selector=""
sort_mode="default" # --sort: name|changes|dirty|default
show_problems=1     # show deferred problems (disabled when selector is used)

usage() {
  cat <<'EOF'
Usage: repos [options] [index|name]

Options:
  -v              Verbose output for all repos
  -l              Show "files" section even when clean (verbose output)
  -f              Show "files" section only when dirty (verbose output) [overrides -l]
  -d              List only dirty repos (works in short + verbose)
  -p, --path      Show repo path (short mode adds it at end of line; verbose shows it too)
  --sort MODE     Sort output: name | changes | dirty | default
  -h, --help      Show this help and exit

Selection:
  repos 8              Show verbose details for repo #8 (as displayed)
  repos chatdot        Show verbose details for repos whose name matches "chatdot"
                       (exact match first, otherwise substring match)

Examples:
  repos
  repos -d
  repos -v
  repos -vd
  repos -p
  repos -vp
  repos --path
  repos --sort name
  repos --sort=changes
  repos --sort dirty
  repos --sort default
  repos 8
  repos bin
  repos -l 8
  repos -f vim-textdecor
EOF
}

die() { echo "$*" >&2; exit 1; }
is_number() { [[ "${1:-}" =~ ^[0-9]+$ ]]; }

# Display helper: collapse the home directory prefix to ~ (cosmetic only,
# doesn't affect any path actually used for filesystem/git operations).
display_path() {
  local path="$1"
  if [[ "$path" == "$HOME" ]]; then
    printf '~'
  elif [[ "$path" == "$HOME"/* ]]; then
    printf '~/%s' "${path#"$HOME"/}"
  else
    printf '%s' "$path"
  fi
}

# ============================================================
# Option parsing (supports bundled flags: -vdp)
# ============================================================
parse_args() {
  local args=("$@") i=0 arg

  while ((i < ${#args[@]})); do
    arg="${args[i]}"
    case "$arg" in
      --)
        ((++i))
        ((i < ${#args[@]})) && selector="${args[i]}"
        ;;
      -h|--help) usage; exit 0 ;;
      -p|--path) show_path=1 ;;
      --sort)
        ((++i))
        sort_mode="${args[i]:-}"
        [[ -n "$sort_mode" ]] || die "Missing value for --sort (name|changes|dirty|default)"
        ;;
      --sort=*)
        sort_mode="${arg#--sort=}"
        ;;
      -*)
        local flags="${arg#-}" j c
        for ((j = 0; j < ${#flags}; j++)); do
          c="${flags:j:1}"
          case "$c" in
            v) verbose=1 ;;
            l) list_files=1 ;;
            f) files_dirty_only=1 ;;
            d) dirty_only=1 ;;
            p) show_path=1 ;;
            h) usage; exit 0 ;;
            *) die "Unknown option: -$c" ;;
          esac
        done
        ;;
      *)
        selector="$arg"
        ;;
    esac
    ((++i))
  done

  # -f overrides -l
  [[ "$files_dirty_only" == 1 ]] && list_files=0

  # if user requests files behavior without selector, show verbose so it becomes visible
  if [[ -z "$selector" && ( "$list_files" == 1 || "$files_dirty_only" == 1 ) ]]; then
    verbose=1
  fi

  case "$sort_mode" in
    default | name | changes | dirty) : ;;
    *) die "Invalid --sort value: $sort_mode (use: name|changes|dirty|default)" ;;
  esac
}

# ============================================================
# Dedup
# ============================================================
declare -A SEEN
seen_add_or_skip() {
  local key="${1%/}"
  [[ -n "${SEEN[$key]+x}" ]] && return 1
  SEEN["$key"]=1
  return 0
}

# ============================================================
# Problems (deferred to the end)
# ============================================================
declare -a P_ICON P_NAME P_MSG

add_problem() {
  P_ICON+=("$1")
  P_NAME+=("$2")
  P_MSG+=("$3")
}

print_problem() { add_problem "$1" "$2" "$3"; }

# ============================================================
# Git helpers
# ============================================================
git_status_normal() { git -C "$1" status --porcelain=2 --branch; }
git_status_bare()   { git --git-dir="$1" --work-tree="$2" status --porcelain=2 --branch; }

git_last_normal() { git -C "$1" log -1 --pretty=format:'%h %s' 2>/dev/null || true; }
git_last_bare()   { git --git-dir="$1" --work-tree="$2" log -1 --pretty=format:'%h %s' 2>/dev/null || true; }

bare_branch() { git --git-dir="$1" --work-tree="$2" symbolic-ref -q --short HEAD 2>/dev/null || true; }

bare_upstream_from_config() {
  local gitdir="$1" worktree="$2" branch="$3"
  [[ -z "$branch" ]] && return 0

  local remote merge
  remote="$(git --git-dir="$gitdir" --work-tree="$worktree" config --get "branch.${branch}.remote" 2>/dev/null || true)"
  merge="$(git --git-dir="$gitdir" --work-tree="$worktree" config --get "branch.${branch}.merge" 2>/dev/null || true)"

  [[ -z "$remote" || -z "$merge" ]] && return 0
  printf '%s/%s' "$remote" "${merge#refs/heads/}"
}

bare_ab_counts_from_upstream_ref() {
  local gitdir="$1" worktree="$2" upstream_ref="$3"
  git --git-dir="$gitdir" --work-tree="$worktree" \
    rev-list --left-right --count "${upstream_ref}...HEAD" 2>/dev/null || true
}

# If porcelain doesn't include upstream/ab for bare repos, inject them.
augment_bare_status_if_needed() {
  local gitdir="$1" worktree="$2" status="$3"

  # If already has branch.upstream, do nothing
  if awk '$2=="branch.upstream"{found=1} END{exit !found}' <<<"$status"; then
    printf '%s' "$status"
    return
  fi

  local branch upstream remote merge_short upstream_ref counts behind ahead
  branch="$(bare_branch "$gitdir" "$worktree")"
  upstream="$(bare_upstream_from_config "$gitdir" "$worktree" "$branch")"
  [[ -z "$upstream" ]] && { printf '%s' "$status"; return; }

  remote="${upstream%%/*}"
  merge_short="${upstream#*/}"
  upstream_ref="refs/remotes/${remote}/${merge_short}"

  counts="$(bare_ab_counts_from_upstream_ref "$gitdir" "$worktree" "$upstream_ref")"
  if [[ -n "$counts" ]]; then
    read -r behind ahead <<<"$counts"
  else
    behind=0
    ahead=0
  fi

  status+=$'\n'"# branch.upstream $upstream"
  status+=$'\n'"# branch.ab +${ahead:-0} -${behind:-0}"
  printf '%s' "$status"
}

# ============================================================
# Status parsing + predicates
# ============================================================
extract_summary() {
  local status="$1"
  local branch changes_count ahead behind

  branch="$(awk '$2=="branch.head"{print $3}' <<<"$status")"
  changes_count="$(grep -cE '^[12?] ' <<<"$status" || true)"

  ahead="$(awk '$2=="branch.ab"{gsub(/^\+/,"",$3); print $3}' <<<"$status")"
  behind="$(awk '$2=="branch.ab"{gsub(/^-/, "",$4); print $4}' <<<"$status")"

  printf '%s|%s|%s|%s\n' \
    "${branch:-"(detached)"}" \
    "${changes_count:-0}" \
    "${behind:-}" \
    "${ahead:-}"
}

is_dirty_status() { grep -qE '^[12?] ' <<<"$1"; }

status_upstream() {
  awk '$2=="branch.upstream"{print $3}' <<<"$1"
}

files_lines() {
  # porcelain v2 changed files lines start with: 1, 2, or ?
  grep -E '^[12?] ' <<<"$1" || true
}

changes_count_from_status() {
  local branch changes_count behind ahead
  IFS='|' read -r branch changes_count behind ahead < <(extract_summary "$1")
  printf '%s' "${changes_count:-0}"
}

# ============================================================
# Presentation helpers (shared between short + verbose)
# ============================================================

# Truncate text to fit a column width (adding an ellipsis), or pad it
# with trailing spaces if it's shorter. Keeps table columns aligned
# regardless of content length.
fit_column() {
  local text="$1" width="$2" len="${#1}"
  if ((len > width)); then
    if ((width > 1)); then
      printf '%s' "${text:0:width - 1}…"
    else
      printf '%s' "${text:0:width}"
    fi
  else
    printf '%-*s' "$width" "$text"
  fi
}

icon_width_for() {
  printf '%s' "${ICON_WIDTH[$1]:-$ICON_WIDTH_DEFAULT}"
}

# Icon + a visually-consistent gap before the next column. Narrow
# glyphs (width 1) get an extra space so they don't look flush
# against the following text compared to wide glyphs (width 2).
pad_icon() {
  local icon="$1"
  if [[ "$(icon_width_for "$icon")" == "2" ]]; then
    printf '%s ' "$icon"
  else
    printf '%s  ' "$icon"
  fi
}

format_changes_plain() {
  local changes_count="$1"
  [[ "$changes_count" == "0" ]] && printf 'CLEAN' || printf 'CHANGES:%s' "$changes_count"
}

format_changes_colored() {
  local changes_count="$1" text="$2"
  if [[ "$changes_count" == "0" ]]; then
    printf '%b' "${GREEN}${text}${RESET}"
  else
    printf '%b' "${YELLOW}${text}${RESET}"
  fi
}

format_sync_plain() {
  local ahead="${1:-}" behind="${2:-}"

  if [[ -n "$ahead" || -n "$behind" ]]; then
    ahead="${ahead:-0}"
    behind="${behind:-0}"
    [[ "$ahead" == "0" && "$behind" == "0" ]] && { printf 'UP-TO-DATE'; return; }
    printf 'AHEAD:%s BEHIND:%s' "$ahead" "$behind"
    return
  fi

  printf 'NO-UPSTREAM'
}

format_sync_colored() {
  local ahead="${1:-}" behind="${2:-}"

  if [[ -n "$ahead" || -n "$behind" ]]; then
    ahead="${ahead:-0}"
    behind="${behind:-0}"
    if [[ "$ahead" == "0" && "$behind" == "0" ]]; then
      printf 'UP-TO-DATE'
      return
    fi

    local ahead_txt="AHEAD:$ahead"
    local behind_txt="BEHIND:$behind"
    [[ "$ahead" != "0" ]] && ahead_txt="${YELLOW}${ahead_txt}${RESET}"
    [[ "$behind" != "0" ]] && behind_txt="${RED}${behind_txt}${RESET}"
    printf '%b %b' "$ahead_txt" "$behind_txt"
    return
  fi

  printf 'NO-UPSTREAM'
}

should_show_files_section() {
  local changes_count="$1"

  # -f : only when dirty
  if [[ "$files_dirty_only" == 1 ]]; then
    [[ "$changes_count" != "0" ]] && return 0 || return 1
  fi

  # -l : always
  if [[ "$list_files" == 1 ]]; then
    return 0
  fi

  # default: only when dirty
  [[ "$changes_count" != "0" ]] && return 0 || return 1
}

# ============================================================
# Printing
# ============================================================
print_verbose() {
  local name="$1" where="$2" status="$3" last="${4:-N/A}"

  local branch changes_count behind ahead
  IFS='|' read -r branch changes_count behind ahead < <(extract_summary "$status")

  local upstream
  upstream="$(status_upstream "$status")"

  local sync_colored changes_label
  sync_colored="$(format_sync_colored "$ahead" "$behind")"
  changes_label="$(format_changes_colored "$changes_count" "$(format_changes_plain "$changes_count")")"

  printf "%b\n" "${BOLD}${ICON_REPO}${name}${RESET}"
  printf "  path:      ${GRAY}%s${RESET}\n" "$(display_path "$where")"

  printf "  branch:    ${BOLD}${GRAY}%s${RESET}\n" "$branch"
  printf "  upstream:  ${GRAY}%s${RESET}\n" "${upstream:-NO-UPSTREAM}"
  printf "  status:    %b\n" "$changes_label"
  printf "  sync:      %b\n" "$sync_colored"
  printf "  last:      ${GRAY}%s${RESET}\n" "${last:-N/A}"

  if should_show_files_section "$changes_count"; then
    printf "  files:\n"
    local files total_lines
    files="$(files_lines "$status")"
    if [[ -n "$files" ]]; then
      printf "%s\n" "$files" | head -n 12 | sed 's/^/    /'
      total_lines="$(printf "%s\n" "$files" | wc -l | tr -d ' ')"
      if [[ "$total_lines" -gt 12 ]]; then
        printf "    ${GRAY}... (%s more)${RESET}\n" "$((total_lines - 12))"
      fi
    else
      printf "    ${GRAY}(working tree clean)${RESET}\n"
    fi
  fi

  printf "\n"
}

print_short() {
  local idx="$1" name="$2" status="$3" where="$4"

  local branch changes_count behind ahead
  IFS='|' read -r branch changes_count behind ahead < <(extract_summary "$status")

  local idx_p icon_p name_p branch_p changes_p sync_colored changes_colored
  idx_p="$(printf "%2s" "$idx")"
  icon_p="$(pad_icon "$ICON_REPO")"
  name_p="$(fit_column "$name" "$COL_NAME")"
  branch_p="$(fit_column "$branch" "$COL_BRANCH")"
  changes_p="$(fit_column "$(format_changes_plain "$changes_count")" "$COL_CHANGES")"
  changes_colored="$(format_changes_colored "$changes_count" "$changes_p")"

  local sync_plain sync_pad
  sync_plain="$(format_sync_plain "$ahead" "$behind")"
  sync_colored="$(format_sync_colored "$ahead" "$behind")"
  sync_pad=$((COL_SYNC - ${#sync_plain}))
  ((sync_pad < 0)) && sync_pad=0
  sync_colored+="$(printf '%*s' "$sync_pad" '')"

  local line
  line="$(printf "${GRAY}%s${RESET} ${GRAY}-${RESET} %s${BOLD}%s${RESET} ${BOLD}${GRAY}%s${RESET} %b %b" \
    "$idx_p" "$icon_p" "$name_p" "$branch_p" "$changes_colored" "$sync_colored")"

  if [[ "$show_path" == 1 ]]; then
    line+="$(printf " ${GRAY}%s${RESET}" "$(display_path "$where")")"
  fi

  printf "%b\n" "$line"
}

render_problems() {
  [[ "${show_problems:-1}" -eq 1 ]] || return 0

  local i n="${#P_NAME[@]}"
  [[ "$n" -eq 0 ]] && return 0

  printf "\n"
  for ((i = 0; i < n; i++)); do
    printf "%b\n" "$(printf "%s${YELLOW}%-${COL_NAME}s${RESET} ${RED}%s${RESET}" \
      "$(pad_icon "${P_ICON[$i]}")" "${P_NAME[$i]}" "${P_MSG[$i]}")"
  done
}

# ============================================================
# Repo discovery
# ============================================================
is_repo() { [[ -d "$1/.git" ]]; }

discover_repos_under() {
  local base="$1"
  [[ -d "$base" ]] || return 0
  find "$base" \
    -mindepth 2 -maxdepth "$SCAN_DEPTH" \
    -type d -name .git -prune -print 2>/dev/null \
  | sed 's|/\.git$||' \
  | sort -u
}

# ============================================================
# Storage
# ============================================================
declare -a R_NAME R_WHERE R_STATUS R_LAST
declare -a ORDER # indices (0-based) controlling display order

add_entry() {
  R_NAME+=("$1")
  R_WHERE+=("$2")
  R_STATUS+=("$3")
  R_LAST+=("${4:-N/A}")
}

match_indices_by_name() {
  local q="$1" i out=""

  for i in "${!R_NAME[@]}"; do
    [[ "${R_NAME[$i]}" == "$q" ]] && out+="$((i + 1))"$'\n'
  done
  if [[ -n "$out" ]]; then
    printf '%s' "$out"
    return 0
  fi

  for i in "${!R_NAME[@]}"; do
    [[ "${R_NAME[$i]}" == *"$q"* ]] && printf '%s\n' "$((i + 1))"
  done
}

# ============================================================
# Sorting (display order)
# ============================================================
build_order() {
  ORDER=()
  local n="${#R_NAME[@]}"
  local i

  if [[ "$sort_mode" == "default" ]]; then
    for ((i = 0; i < n; i++)); do ORDER+=("$i"); done
    return 0
  fi

  local lines="" name changes dirtyflag
  for ((i = 0; i < n; i++)); do
    name="${R_NAME[$i]}"
    changes="$(changes_count_from_status "${R_STATUS[$i]}")"
    if is_dirty_status "${R_STATUS[$i]}"; then
      dirtyflag=0 # dirty first
    else
      dirtyflag=1
    fi

    case "$sort_mode" in
      name) lines+="${name}|${i}"$'\n' ;;
      changes) lines+="${changes}|${name}|${i}"$'\n' ;;
      dirty) lines+="${dirtyflag}|${changes}|${name}|${i}"$'\n' ;;
    esac
  done

  local sorted
  case "$sort_mode" in
    name)
      sorted="$(LC_ALL=C sort -t'|' -k1,1 <<<"$lines")"
      while IFS='|' read -r _ idx; do
        [[ -n "${idx:-}" ]] && ORDER+=("$idx")
      done <<<"$sorted"
      ;;
    changes)
      sorted="$(LC_ALL=C sort -t'|' -k1,1nr -k2,2 <<<"$lines")"
      while IFS='|' read -r _ _ idx; do
        [[ -n "${idx:-}" ]] && ORDER+=("$idx")
      done <<<"$sorted"
      ;;
    dirty)
      sorted="$(LC_ALL=C sort -t'|' -k1,1n -k2,2nr -k3,3 <<<"$lines")"
      while IFS='|' read -r _ _ _ idx; do
        [[ -n "${idx:-}" ]] && ORDER+=("$idx")
      done <<<"$sorted"
      ;;
  esac
}

real_index_from_display_index() {
  local display_idx="$1" n="${#ORDER[@]}"
  [[ "$display_idx" -ge 1 && "$display_idx" -le "$n" ]] || return 1
  printf '%s' "${ORDER[$((display_idx - 1))]}"
}

# ============================================================
# Collect stage
# ============================================================
collect_from_normal_repo() {
  local path="$1"
  local status last
  status="$(git_status_normal "$path")"
  last="$(git_last_normal "$path")"
  add_entry "$(basename "$path")" "$path" "$status" "$last"
}

collect_from_bare_entry() {
  local gitdir="$1" worktree="$2" name="$3"

  [[ -d "$gitdir" ]] || { print_problem "$ICON_ERROR" "$name" "GITDIR-NOT-FOUND"; return 0; }

  seen_add_or_skip "BARE:$gitdir" || return 0

  local status last
  status="$(git_status_bare "$gitdir" "$worktree")"
  status="$(augment_bare_status_if_needed "$gitdir" "$worktree" "$status")"
  last="$(git_last_bare "$gitdir" "$worktree")"

  add_entry "$name" "$worktree" "$status" "$last"
}

collect_from_line() {
  local line="$1"
  [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && return 0

  line="${line/#\~/$HOME}"

  if [[ "$line" == BARE\|* ]]; then
    local _ gitdir worktree name
    IFS='|' read -r _ gitdir worktree name <<<"$line"
    name="${name:-BARE}"
    gitdir="${gitdir/#\~/$HOME}"
    worktree="${worktree/#\~/$HOME}"
    collect_from_bare_entry "$gitdir" "$worktree" "$name"
    return 0
  fi

  local repo="$line"
  if [[ ! -d "$repo" ]]; then
    print_problem "$ICON_ERROR" "$(basename "$repo")" "NOT-FOUND"
    return 0
  fi

  if ! is_repo "$repo"; then
    local found_any=0 subrepo
    while IFS= read -r subrepo; do
      [[ -n "$subrepo" ]] || continue
      seen_add_or_skip "$subrepo" || continue
      found_any=1
      collect_from_normal_repo "$subrepo"
    done < <(discover_repos_under "$repo")

    [[ "$found_any" == 0 ]] && print_problem "$ICON_WARNING" "$(basename "$repo")" "NOT-A-REPO"
    return 0
  fi

  seen_add_or_skip "$repo" || return 0
  collect_from_normal_repo "$repo"
}

# ============================================================
# Render stage
# ============================================================
passes_dirty_filter() {
  local status="$1"
  [[ "$dirty_only" == 1 ]] && is_dirty_status "$status" && return 0
  [[ "$dirty_only" == 1 ]] && return 1
  return 0
}

render_short_list() {
  local disp=0 i
  for i in "${ORDER[@]}"; do
    passes_dirty_filter "${R_STATUS[$i]}" || continue
    disp="$((disp + 1))"
    print_short "$disp" "${R_NAME[$i]}" "${R_STATUS[$i]}" "${R_WHERE[$i]}"
  done
}

render_verbose_for_display_index() {
  local disp_idx="$1"
  local i
  if ! i="$(real_index_from_display_index "$disp_idx")"; then
    print_problem "$ICON_ERROR" "selector" "OUT-OF-RANGE"
    return 1
  fi

  if [[ "$dirty_only" == 1 ]] && ! is_dirty_status "${R_STATUS[$i]}"; then
    print_problem "$ICON_WARNING" "${R_NAME[$i]}" "CLEAN (filtered by -d)"
    return 0
  fi

  print_verbose "${R_NAME[$i]}" "${R_WHERE[$i]}" "${R_STATUS[$i]}" "${R_LAST[$i]}"
}

render_verbose_all() {
  local i
  for i in "${ORDER[@]}"; do
    passes_dirty_filter "${R_STATUS[$i]}" || continue
    print_verbose "${R_NAME[$i]}" "${R_WHERE[$i]}" "${R_STATUS[$i]}" "${R_LAST[$i]}"
  done
}

render_verbose_by_name_selector() {
  local matches i
  matches="$(match_indices_by_name "$selector" || true)"
  [[ -n "$matches" ]] || { print_problem "$ICON_ERROR" "$selector" "NO-MATCH"; return 1; }

  while IFS= read -r idx; do
    [[ -n "$idx" ]] || continue
    i="$((idx - 1))"
    if [[ "$dirty_only" == 1 ]] && ! is_dirty_status "${R_STATUS[$i]}"; then
      print_problem "$ICON_WARNING" "${R_NAME[$i]}" "CLEAN (filtered by -d)"
      continue
    fi
    print_verbose "${R_NAME[$i]}" "${R_WHERE[$i]}" "${R_STATUS[$i]}" "${R_LAST[$i]}"
  done <<<"$matches"
}

# ============================================================
# Main
# ============================================================
main() {
  parse_args "$@"
  [[ -f "$repos_file" ]] || die "Missing $repos_file"

  # If user selects a specific repo/index, hide global problems.
  [[ -n "$selector" ]] && show_problems=0

  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    collect_from_line "$line"
  done <"$repos_file"

  build_order

  if [[ -n "$selector" ]]; then
    verbose=1
    if is_number "$selector"; then
      render_verbose_for_display_index "$selector"
    else
      render_verbose_by_name_selector
    fi
    return
  fi

  if [[ "$verbose" == 1 ]]; then
    render_verbose_all
  else
    render_short_list
  fi

  render_problems
}

main "$@"
